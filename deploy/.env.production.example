# Copy to deploy/.env.production (ignored). Keep APP/API on the same parent domain.
APP_DOMAIN=finance.example.com
API_DOMAIN=api.finance.example.com
TLS_EMAIL=operator@example.com
POSTGRES_USER=finance
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
POSTGRES_DB=finance
DATABASE_URL=postgresql://finance:REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD@db:5432/finance?schema=public
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Start API/UI first. Enable the separate worker profile only when configured.
MARKET_DATA_ENABLED=0
EODHD_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
OPERATOR_USER_ID=
