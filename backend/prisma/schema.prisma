generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  wallet       Wallet?
  portfolios   Portfolio[]
  watchlists   Watchlist[]
  priceAlerts  PriceAlert[]
  telegramConnection TelegramConnection?
  telegramPairings TelegramPairing[]
  notifications Notification[]
  financialReports FinancialReport[]
  investmentNotes InvestmentNote[]
  importBatches ImportBatch[]
  brokerConnections BrokerConnection[]
}

enum PortfolioMode {
  MANUAL
  PAPER
}

model Portfolio {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String              @db.VarChar(100)
  accounts  InvestmentAccount[]
  valuations PortfolioValuationSnapshot[]
  mode PortfolioMode @default(MANUAL)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([userId])
}

model InvestmentAccount {
  id          String    @id @default(uuid()) @db.Uuid
  portfolioId String    @db.Uuid
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(100)
  archivedAt  DateTime?  @db.Timestamptz(3)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  events      InvestmentEvent[]
  importBatches ImportBatch[]
  strategies Strategy[]
  brokerConnection BrokerConnection?

  // Ownership is derived through Portfolio.userId, without a second userId.
  @@index([portfolioId])
}

enum ImportFileFormat {
  GENERIC
  IBKR_FLEX
}

enum ImportBatchStatus {
  PARSED
  INVALID
  CONFIRMED
}

model ImportBatch {
  id          String            @id @default(uuid()) @db.Uuid
  accountId   String            @db.Uuid
  account     InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  authorId    String            @db.Uuid
  author      User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  format      ImportFileFormat
  status      ImportBatchStatus
  contentHash String            @db.Char(64)
  encoding    String            @db.VarChar(24)
  separator   String            @db.Char(1)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  rows        ImportRow[]
  confirmedAt DateTime?         @db.Timestamptz(3)
  confirmationHash String?      @db.Char(64)
  confirmation Json?

  @@unique([accountId, authorId, format, contentHash])
  @@index([authorId])
  @@index([accountId, createdAt])
}

model ImportRow {
  batchId String      @db.Uuid
  batch   ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  number  Int
  data    Json?
  error   String?     @db.VarChar(512)
  mappedInstrumentId String? @db.Uuid
  mappedInstrument Instrument? @relation(fields: [mappedInstrumentId], references: [id], onDelete: SetNull)

  @@id([batchId, number])
  @@index([mappedInstrumentId])
}

enum InvestmentCurrency {
  PLN
  USD
}

model Instrument {
  id               String                      @id @default(uuid()) @db.Uuid
  name             String?                     @db.VarChar(200)
  ticker           String                      @db.VarChar(32)
  mic              String                      @db.VarChar(4)
  currency         InvestmentCurrency
  isin             String?                     @db.VarChar(12)
  companyId        String?                     @db.Uuid
  company          Company?                    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  financialReports FinancialReport[]
  investmentNotes InvestmentNote[]
  importRows ImportRow[]
  strategies Strategy[]
  signals Signal[]
  paperOrders Order[]
  providerMappings InstrumentProviderMapping[]
  trades           Trade[]
  openingLots      OpeningLot[]
  securityEntries  SecurityEntry[]
  priceBars        PriceBar[]
  corporateActions CorporateAction[]
  splits           InvestmentSplit[]
  watchlistItems   WatchlistItem[]
  priceAlerts      PriceAlert[]
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  // Later investment events will reference this ID, never a mutable ticker.
  @@unique([mic, ticker])
  @@index([isin])
  @@index([companyId])
}

model InvestmentNote {
  userId           String     @db.Uuid
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrumentId     String     @db.Uuid
  instrument       Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  thesis           String     @db.VarChar(4000)
  risks            String     @db.VarChar(4000)
  reviewConditions String     @db.VarChar(4000)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  @@id([userId, instrumentId])
  @@index([instrumentId])
}

model Company {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(200)
  instruments Instrument[]
  reports     FinancialReport[]
  createdAt   DateTime          @default(now())
}

enum FinancialReportScope {
  CONSOLIDATED
  STANDALONE
}

enum FinancialReportPeriod {
  ANNUAL
  QUARTERLY
}

enum FinancialReportCurrency {
  PLN
  USD
  EUR
}

enum FundamentalMetric {
  REVENUE
  EBIT
  NET_INCOME
  OPERATING_CASH_FLOW
  LONG_TERM_DEBT
  DILUTED_EPS
  BOOK_VALUE_PER_SHARE
  TOTAL_EQUITY
}

model FinancialReport {
  id           String                  @id @default(uuid()) @db.Uuid
  userId       String                  @db.Uuid
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId    String                  @db.Uuid
  company      Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  instrumentId String                  @db.Uuid
  instrument   Instrument              @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  scope        FinancialReportScope
  periodKind   FinancialReportPeriod
  periodStart  DateTime                @db.Date
  periodEnd    DateTime                @db.Date
  publishedOn  DateTime                @db.Date
  currency     FinancialReportCurrency
  sourceUrl    String                  @db.VarChar(2048)
  businessSummary String?              @db.VarChar(600)
  filename     String                  @db.VarChar(200)
  version      Int
  contentHash  String                  @db.Char(64)
  pdf          Bytes
  parsedReport Json
  facts        FundamentalFact[]
  createdAt    DateTime                @default(now()) @db.Timestamptz(3)

  @@unique([userId, companyId, scope, periodKind, periodStart, periodEnd, version], map: "FinancialReport_period_version_key")
  @@unique([userId, companyId, scope, periodKind, periodStart, periodEnd, contentHash], map: "FinancialReport_period_hash_key")
  @@index([userId, createdAt])
  @@index([companyId])
  @@index([instrumentId])
}

model FundamentalFact {
  reportId String            @db.Uuid
  report   FinancialReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  metric   FundamentalMetric
  amount   Decimal           @db.Decimal(38, 10)
  unit     String            @db.VarChar(16)
  period   String            @db.VarChar(64)
  page     Int

  @@id([reportId, metric])
}

model MarketDataBudget {
  provider      String   @db.VarChar(30)
  keyHash       String   @db.Char(64)
  day           DateTime @db.Date
  spent         Int      @default(0)
  lastRequestAt DateTime? @db.Timestamptz(3)
  blockedUntil  DateTime? @db.Timestamptz(3)
  @@id([provider, keyHash, day])
}

model MarketJob {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(200)
  kind        String   @db.VarChar(30)
  payload     Json
  status      String   @default("PENDING") @db.VarChar(20)
  priority    Int      @default(10)
  attempts    Int      @default(0)
  runAfter    DateTime @default(now()) @db.Timestamptz(3)
  leaseUntil  DateTime? @db.Timestamptz(3)
  runToken    String?  @db.Uuid
  errorCode   String?  @db.VarChar(40)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  finishedAt  DateTime? @db.Timestamptz(3)
  @@index([status, runAfter, priority])
}

model WorkerHeartbeat {
  name      String   @id @db.VarChar(80)
  updatedAt DateTime @db.Timestamptz(3)
}

model PriceBar {
  id            String   @id @default(uuid()) @db.Uuid
  instrumentId  String   @db.Uuid
  instrument    Instrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  source        String   @db.VarChar(30)
  sessionOn     DateTime @db.Date
  open          Decimal  @db.Decimal(28, 10)
  high          Decimal  @db.Decimal(28, 10)
  low           Decimal  @db.Decimal(28, 10)
  close         Decimal  @db.Decimal(28, 10)
  adjustedClose Decimal  @db.Decimal(28, 10)
  volume        Decimal  @db.Decimal(28, 0)
  revision      Int      @default(1)
  currentSlot   Int?     @default(1)
  contentHash   String   @db.Char(64)
  publishedAt   DateTime? @db.Timestamptz(3)
  fetchedAt     DateTime @default(now()) @db.Timestamptz(3)
  alertEvents   AlertEvent[]
  @@unique([instrumentId, source, sessionOn, revision])
  @@unique([instrumentId, source, sessionOn, currentSlot])
  @@index([instrumentId, sessionOn])
}

model FxRate {
  id          String   @id @default(uuid()) @db.Uuid
  source      String   @db.VarChar(30)
  base        InvestmentCurrency @default(USD)
  quote       InvestmentCurrency @default(PLN)
  sessionOn   DateTime @db.Date
  rate        Decimal  @db.Decimal(28, 8)
  reference   String   @db.VarChar(80)
  revision    Int      @default(1)
  currentSlot Int?     @default(1)
  contentHash String   @db.Char(64)
  publishedAt DateTime? @db.Timestamptz(3)
  fetchedAt   DateTime @default(now()) @db.Timestamptz(3)
  @@unique([source, base, quote, sessionOn, revision])
  @@unique([source, base, quote, sessionOn, currentSlot])
}

enum CorporateActionKind {
  SPLIT
  DIVIDEND
}

model CorporateAction {
  id          String   @id @default(uuid()) @db.Uuid
  instrumentId String @db.Uuid
  instrument  Instrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  source      String   @db.VarChar(30)
  kind        CorporateActionKind
  exDate      DateTime @db.Date
  paymentOn   DateTime? @db.Date
  currency    InvestmentCurrency?
  amount      Decimal? @db.Decimal(28, 8)
  amountBasis String?  @db.VarChar(30)
  numerator   Decimal? @db.Decimal(28, 10)
  denominator Decimal? @db.Decimal(28, 10)
  revision    Int      @default(1)
  currentSlot Int?     @default(1)
  contentHash String   @db.Char(64)
  publishedAt DateTime? @db.Timestamptz(3)
  fetchedAt   DateTime @default(now()) @db.Timestamptz(3)
  events      InvestmentEvent[]
  @@unique([instrumentId, source, kind, exDate, revision])
  @@unique([instrumentId, source, kind, exDate, currentSlot])
}

model InstrumentProviderMapping {
  id           String     @id @default(uuid()) @db.Uuid
  instrumentId String     @db.Uuid
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  provider     String     @db.VarChar(50)
  symbol       String     @db.VarChar(64)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([provider, symbol])
  @@unique([instrumentId, provider])
}

enum InvestmentEventType {
  DEPOSIT
  WITHDRAWAL
  BUY
  SELL
  DIVIDEND
  FEE
  FX
  SPLIT
  OPENING_POSITION
  CORRECTION
}

enum InvestmentEventSource {
  MANUAL
  IMPORT
  BROKER
  SYSTEM
}

enum InvestmentTimePrecision {
  DATE
  INSTANT
}

enum InvestmentOrderingSource {
  EXPLICIT
  MIGRATED_UNVERIFIED
}

model InvestmentEvent {
  id               String                   @id @default(uuid()) @db.Uuid
  accountId        String                   @db.Uuid
  account          InvestmentAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type             InvestmentEventType
  source           InvestmentEventSource    @default(MANUAL)
  sourceKey        String                   @db.VarChar(100)
  externalOperationId String?               @db.VarChar(128)
  idempotencyKey   String?                  @db.VarChar(128)
  payloadHash      String?                  @db.Char(64)
  recordedBy       String                   @db.VarChar(128)
  occurredOn       DateTime                 @db.Date
  timePrecision    InvestmentTimePrecision  @default(DATE)
  executedAt       DateTime?                @db.Timestamptz(3)
  sourceTimeZone   String?                  @db.VarChar(64)
  marketSessionOn  DateTime?                @db.Date
  settledOn        DateTime?                @db.Date
  daySequence      Int
  orderingSource   InvestmentOrderingSource @default(EXPLICIT)
  recordedAt       DateTime                 @default(now()) @db.Timestamptz(3)
  fxRatePlnPerUsd  Decimal?                 @db.Decimal(28, 8)
  correctionOfId   String?                  @db.Uuid
  correctionOf     InvestmentEvent?         @relation("InvestmentCorrections", fields: [correctionOfId, accountId], references: [id, accountId], onDelete: Cascade)
  corrections      InvestmentEvent[]        @relation("InvestmentCorrections")
  correctionReason String?                  @db.VarChar(500)
  revision         Int                      @default(0)
  // 1 is the effective revision; NULL keeps superseded versions in the audit trail.
  activeSlot       Int?                     @default(1)
  trade            Trade?
  openingLot       OpeningLot?
  split            InvestmentSplit?
  corporateActionId String? @db.Uuid
  corporateAction CorporateAction? @relation(fields: [corporateActionId], references: [id], onDelete: Restrict)
  cashEntries      CashEntry[]
  securityEntries  SecurityEntry[]
  paperFill Fill?

  // Migrated ordering must be reviewed before posting or replaying legacy events.
  // Source and actor identifiers are snapshots; posting checks account ownership.
  @@unique([id, accountId])
  @@unique([accountId, occurredOn, daySequence, activeSlot])
  @@unique([accountId, source, sourceKey, externalOperationId], map: "InvestmentEvent_external_identity_key")
  @@unique([accountId, idempotencyKey])
  @@index([accountId, recordedAt, id])
  @@index([correctionOfId])
}

model InvestmentSplit {
  id           String @id @default(uuid()) @db.Uuid
  eventId      String @unique @db.Uuid
  event        InvestmentEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  instrumentId String @db.Uuid
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  numerator    Decimal @db.Decimal(28, 10)
  denominator  Decimal @db.Decimal(28, 10)
  @@index([instrumentId])
}

model PortfolioValuationSnapshot {
  id           String @id @default(uuid()) @db.Uuid
  portfolioId  String @db.Uuid
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asOf         DateTime @db.Date
  contentHash  String @db.Char(64)
  ledgerHash   String @db.Char(64)
  data         Json
  currentSlot  Int? @default(1)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  @@unique([portfolioId, asOf, contentHash])
  @@unique([portfolioId, asOf, currentSlot])
}

model Trade {
  id           String          @id @default(uuid()) @db.Uuid
  eventId      String          @unique @db.Uuid
  event        InvestmentEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  instrumentId String          @db.Uuid
  instrument   Instrument      @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  quantity     Decimal         @db.Decimal(28, 10)
  unitPrice    Decimal         @db.Decimal(28, 10)
  grossAmount  Decimal         @db.Decimal(28, 8)

  @@index([instrumentId])
}

model OpeningLot {
  id           String          @id @default(uuid()) @db.Uuid
  eventId      String          @unique @db.Uuid
  event        InvestmentEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  instrumentId String          @db.Uuid
  instrument   Instrument      @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  quantity     Decimal         @db.Decimal(28, 10)
  totalCost    Decimal         @db.Decimal(28, 8)
  acquiredOn   DateTime        @db.Date

  @@index([instrumentId])
}

enum CashEntryKind {
  EXTERNAL_TRANSFER
  TRADE_GROSS
  COMMISSION
  DIVIDEND_GROSS
  WITHHOLDING_TAX
  FEE
  FX
}

model CashEntry {
  id       String             @id @default(uuid()) @db.Uuid
  eventId  String             @db.Uuid
  event    InvestmentEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind     CashEntryKind
  currency InvestmentCurrency
  amount   Decimal            @db.Decimal(28, 8)

  @@index([eventId])
}

model SecurityEntry {
  id           String          @id @default(uuid()) @db.Uuid
  eventId      String          @db.Uuid
  event        InvestmentEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  instrumentId String          @db.Uuid
  instrument   Instrument      @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  quantity     Decimal         @db.Decimal(28, 10)

  @@index([eventId])
  @@index([instrumentId])
}

enum Currency {
  PLN
}

model Wallet {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @unique @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String        @default("Mój portfel")
  currency       Currency      @default(PLN)
  openingBalance Decimal       @default(0) @db.Decimal(14, 2)
  transactions   Transaction[]
  creationRequests TransactionCreation[]
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Category {
  id           String          @id @default(uuid()) @db.Uuid
  name         String          @db.VarChar(100)
  type         TransactionType
  transactions Transaction[]

  // The composite foreign key also enforces the transaction's direction.
  @@unique([id, type])
}

model Transaction {
  id         String          @id @default(uuid()) @db.Uuid
  walletId   String          @db.Uuid
  wallet     Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type       TransactionType
  amount     Decimal         @db.Decimal(14, 2)
  categoryId String          @db.Uuid
  category   Category        @relation(fields: [categoryId, type], references: [id, type], onDelete: Restrict, onUpdate: Restrict)
  title      String          @db.VarChar(100)
  note       String?         @db.VarChar(1000)
  occurredOn DateTime        @db.Date
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  creation   TransactionCreation?

  // SQL migration additionally checks positive finite amounts and ISO date range.
  @@index([walletId, occurredOn, id])
  @@index([categoryId, type])
}

model TransactionCreation {
  walletId      String       @db.Uuid
  key           String       @db.Uuid
  payloadHash   String       @db.Char(64)
  transactionId String?      @unique @db.Uuid
  wallet        Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@id([walletId, key])
}

model Watchlist {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String @db.VarChar(100)
  items     WatchlistItem[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([userId])
}
model WatchlistItem {
  id           String @id @default(uuid()) @db.Uuid
  watchlistId  String @db.Uuid
  watchlist    Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  instrumentId String @db.Uuid
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  @@unique([watchlistId, instrumentId])
}
model PriceAlert {
  id            String @id @default(uuid()) @db.Uuid
  userId        String @db.Uuid
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrumentId  String @db.Uuid
  instrument    Instrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  direction     String @db.VarChar(10)
  mode          String @db.VarChar(10)
  threshold     Decimal @db.Decimal(28, 10)
  active        Boolean @default(true)
  armed         Boolean @default(false)
  cooldownMinutes Int @default(1440)
  lastSessionOn DateTime? @db.Date
  lastSatisfied Boolean?
  lastPriceBarId String? @db.Uuid
  lastTriggeredAt DateTime? @db.Timestamptz(3)
  deletedAt     DateTime? @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  events        AlertEvent[]
  @@index([userId, deletedAt])
  @@index([instrumentId, active])
}
model AlertEvent {
  id          String @id @default(uuid()) @db.Uuid
  alertId     String @db.Uuid
  alert       PriceAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  priceBarId  String @db.Uuid
  priceBar    PriceBar @relation(fields: [priceBarId], references: [id], onDelete: Restrict)
  sessionOn   DateTime @db.Date
  price       Decimal @db.Decimal(28, 10)
  threshold   Decimal @db.Decimal(28, 10)
  direction   String @db.VarChar(10)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  notification Notification?
  @@unique([alertId, sessionOn])
}

model TelegramPairing {
  codeHash  String @id @db.Char(64)
  userId    String @db.Uuid
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  @@index([userId])
}
model TelegramConnection {
  userId String @id @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId String @unique @db.VarChar(32)
  bindingId String @unique @default(uuid()) @db.Uuid
  quietStart Int @default(1320)
  quietEnd Int @default(420)
  timeZone String @default("Europe/Warsaw") @db.VarChar(64)
  dailySummaryEnabled Boolean @default(false)
  linkedAt DateTime @default(now()) @db.Timestamptz(3)
}
model Notification {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String? @unique @db.Uuid
  event AlertEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  signalId String? @unique @db.Uuid
  signal Signal? @relation(fields: [signalId], references: [id], onDelete: Cascade)
  kind String @default("ALERT") @db.VarChar(20)
  summaryOn DateTime? @db.Date
  body String @db.VarChar(4000)
  state String @default("PENDING") @db.VarChar(20)
  attempts Int @default(0)
  runToken String? @db.Uuid
  bindingId String? @db.Uuid
  messageId String? @db.VarChar(40)
  lastError String? @db.VarChar(40)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  sentAt DateTime? @db.Timestamptz(3)
  deliveries NotificationAttempt[]
  @@unique([userId, summaryOn])
  @@index([userId, createdAt])
}
model NotificationAttempt {
  id String @id @default(uuid()) @db.Uuid
  notificationId String @db.Uuid
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  number Int
  state String @db.VarChar(20)
  startedAt DateTime @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  @@unique([notificationId, number])
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}


model Strategy {
  id           String            @id @default(uuid()) @db.Uuid
  accountId    String            @db.Uuid
  account      InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  instrumentId String            @db.Uuid
  instrument   Instrument        @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  name         String            @db.VarChar(100)
  enabled      Boolean           @default(false)
  notifyOnSignal Boolean         @default(false)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  versions     StrategyVersion[]

  @@index([accountId, createdAt])
  @@index([instrumentId])
}

model StrategyVersion {
  id          String        @id @default(uuid()) @db.Uuid
  strategyId  String        @db.Uuid
  strategy    Strategy      @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  number      Int
  ruleKey     String        @db.VarChar(80)
  codeVersion String        @db.VarChar(32)
  parameters  Json
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  runs        StrategyRun[]
  backtests   BacktestRun[]

  @@unique([strategyId, number])
}

enum StrategyRunMode {
  MANUAL
  SCHEDULED
}

model StrategyRun {
  id        String          @id @default(uuid()) @db.Uuid
  versionId String          @db.Uuid
  version   StrategyVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  decidedAt DateTime        @db.Timestamptz(3)
  mode      StrategyRunMode @default(MANUAL)
  scheduledSessionOn DateTime? @db.Date
  input     Json
  decision  Json
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  signal    Signal?

  @@unique([versionId, decidedAt, mode])
  @@unique([versionId, scheduledSessionOn])
}

enum StrategySignalSide {
  BUY
  SELL
}

model Signal {
  id                String             @id @default(uuid()) @db.Uuid
  runId             String             @unique @db.Uuid
  run               StrategyRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  instrumentId      String             @db.Uuid
  instrument        Instrument         @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  side              StrategySignalSide
  rationale         String             @db.VarChar(500)
  expectedSessionOn DateTime           @db.Date
  decidedAt         DateTime           @db.Timestamptz(3)
  validUntil        DateTime           @db.Timestamptz(3)
  notification      Notification?

  @@index([instrumentId, decidedAt])
}


enum BacktestPhase {
  DEVELOPMENT
  OUT_OF_SAMPLE
}

enum BacktestStatus {
  COMPLETE
  FAILED
}

model BacktestRun {
  id            String          @id @default(uuid()) @db.Uuid
  versionId     String          @db.Uuid
  version       StrategyVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  baselineId    String?         @db.Uuid
  baseline      BacktestRun?    @relation("BacktestBaseline", fields: [baselineId], references: [id], onDelete: Cascade)
  validations   BacktestRun[]   @relation("BacktestBaseline")
  phase         BacktestPhase
  status        BacktestStatus
  fromOn        DateTime        @db.Date
  toOn          DateTime        @db.Date
  modelVersion  String          @db.VarChar(32)
  inputHash     String          @db.Char(64)
  input         Json
  report        Json?
  error         String?         @db.VarChar(500)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)

  @@index([versionId, createdAt])
  @@index([baselineId])
}

enum BrokerMode {
  LOCAL_PAPER
}

enum PaperSide {
  BUY
  SELL
}

enum PaperOrderType {
  MARKET
  LIMIT
}

enum PaperOrderState {
  INTENT
  SENT
  ACCEPTED
  PARTIALLY_FILLED
  FILLED
  REJECTED
  CANCELLED
  UNKNOWN
}

enum PaperEventKind {
  SENT
  ACCEPTED
  FILL
  REJECTED
  CANCELLED
}

model BrokerConnection {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String            @unique @db.Uuid
  account     InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mode        BrokerMode        @default(LOCAL_PAPER)
  idempotencyKey String          @db.Uuid
  payloadHash String             @db.Char(64)
  name        String            @db.VarChar(100)
  openingOn   DateTime          @db.Date
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  orders      Order[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

model Order {
  id          String           @id @default(uuid()) @db.Uuid
  connectionId String         @db.Uuid
  connection  BrokerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  instrumentId String          @db.Uuid
  instrument  Instrument      @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  clientOrderId String         @default(uuid()) @db.Uuid
  idempotencyKey String        @db.VarChar(128)
  payloadHash String           @db.Char(64)
  side        PaperSide
  type        PaperOrderType
  state       PaperOrderState  @default(INTENT)
  quantity    Decimal          @db.Decimal(28, 10)
  filledQuantity Decimal       @default(0) @db.Decimal(28, 10)
  limitPrice  Decimal?         @db.Decimal(28, 10)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  events      OrderEvent[]
  fills       Fill[]

  @@unique([id, connectionId])
  @@unique([connectionId, clientOrderId])
  @@unique([connectionId, idempotencyKey])
  @@index([connectionId, createdAt])
  @@index([instrumentId])
}

model OrderEvent {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @db.Uuid
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  externalEventId String        @db.VarChar(128)
  kind            PaperEventKind
  happenedAt      DateTime      @db.Timestamptz(3)
  payloadHash     String        @db.Char(64)
  recordedAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([orderId, externalEventId])
  @@index([orderId, happenedAt])
}

model Fill {
  id            String          @id @default(uuid()) @db.Uuid
  orderId       String          @db.Uuid
  connectionId  String          @db.Uuid
  order         Order           @relation(fields: [orderId, connectionId], references: [id, connectionId], onDelete: Cascade)
  executionId   String          @db.VarChar(128)
  executedAt    DateTime        @db.Timestamptz(3)
  daySequence   Int
  quantity      Decimal         @db.Decimal(28, 10)
  price         Decimal         @db.Decimal(28, 10)
  fee           Decimal         @db.Decimal(28, 8)
  ledgerEventId String          @unique @db.Uuid
  ledgerEvent   InvestmentEvent @relation(fields: [ledgerEventId], references: [id], onDelete: Cascade)
  payloadHash   String          @db.Char(64)

  @@unique([connectionId, executionId])
  @@index([orderId, connectionId, executedAt])
}
