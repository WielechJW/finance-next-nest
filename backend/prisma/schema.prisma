generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  wallet       Wallet?
}

enum Currency {
  PLN
}

model Wallet {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @unique @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String        @default("Mój portfel")
  currency       Currency      @default(PLN)
  openingBalance Decimal       @default(0) @db.Decimal(14, 2)
  transactions   Transaction[]
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Category {
  id           String          @id @default(uuid()) @db.Uuid
  name         String          @db.VarChar(100)
  type         TransactionType
  transactions Transaction[]

  // The composite foreign key also enforces the transaction's direction.
  @@unique([id, type])
}

model Transaction {
  id         String          @id @default(uuid()) @db.Uuid
  walletId   String          @db.Uuid
  wallet     Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type       TransactionType
  amount     Decimal         @db.Decimal(14, 2)
  categoryId String          @db.Uuid
  category   Category        @relation(fields: [categoryId, type], references: [id, type], onDelete: Restrict, onUpdate: Restrict)
  title      String          @db.VarChar(100)
  note       String?         @db.VarChar(1000)
  occurredOn DateTime        @db.Date
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  // SQL migration additionally checks positive finite amounts and ISO date range.
  @@index([walletId, occurredOn, id])
  @@index([categoryId, type])
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
