# Dopasuj dane do POSTGRES_USER, POSTGRES_PASSWORD i POSTGRES_DB w głównym .env.
DATABASE_URL="postgresql://finance:finance_local_dev@127.0.0.1:5432/finance?schema=public"

# Wygeneruj raz: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_SECONDS=3600
# Liczba zaufanych reverse proxy; lokalnie 0.
TRUST_PROXY_HOPS=0
FRONTEND_ORIGIN=http://localhost:3000

# Limity na IP, osobno dla logowania i rejestracji. Czas w sekundach.
# Przekroczenie limitu blokuje endpoint na taki sam czas jak jego okres.
AUTH_LOGIN_LIMIT=10
AUTH_LOGIN_TTL_SECONDS=60
AUTH_REGISTER_LIMIT=5
AUTH_REGISTER_TTL_SECONDS=900
